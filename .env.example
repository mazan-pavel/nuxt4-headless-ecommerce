# Публичный URL сайта (canonical, OG, sitemap, robots).
# Локально: http://localhost:3000
# Прод: https://nuxt4-headless-ecommerce.vercel.app
NUXT_PUBLIC_SITE_URL=https://nuxt4-headless-ecommerce.vercel.app

# Консультант. Только сервер: без префикса NUXT_PUBLIC_, иначе ключ попадёт в клиент.
# Нет ключа или нет модели — POST /api/assistant отвечает 503. Запасной модели нет.
# Один вопрос пользователя — это обычно 2–3 запроса к модели (инструмент и ответ).
# Бесплатный OpenRouter даёт около 50 запросов в сутки, поэтому дневной лимит ниже.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Лимиты /api/assistant, только сервер. Если переменная не задана — дефолт ниже.
# Один вопрос к консультанту тратит 2–3 запроса модели, а бесплатный OpenRouter
# даёт около 50 запросов в сутки, поэтому дневной лимит по умолчанию 20.
# ASSISTANT_IP_LIMIT=10
# ASSISTANT_IP_WINDOW_MIN=10
# ASSISTANT_DAILY_LIMIT=20

# В production без обеих переменных консультант отвечает 503.
# В nuxt dev лимит хранится в памяти процесса.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
